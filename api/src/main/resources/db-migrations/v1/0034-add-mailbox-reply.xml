<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="0034-add-mailbox-reply" author="bioritmic">
        <addColumn tableName="mailbox">
            <column name="reply_to_message_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="mailbox"
                baseColumnNames="reply_to_message_id"
                referencedTableName="mailbox"
                referencedColumnNames="id"
                constraintName="fk_mailbox_reply_to_message_id"
                onDelete="SET NULL"/>

        <createIndex tableName="mailbox" indexName="idx_mailbox_reply_to_message_id">
            <column name="reply_to_message_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
