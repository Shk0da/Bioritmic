<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="0014-create-user-push-tokens" author="bioritmic">
        <createTable tableName="user_push_tokens">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="token" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="platform" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()"/>
        </createTable>
        <createIndex tableName="user_push_tokens" indexName="idx_user_push_tokens_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="user_push_tokens" indexName="idx_user_push_tokens_token_unique" unique="true">
            <column name="token"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
