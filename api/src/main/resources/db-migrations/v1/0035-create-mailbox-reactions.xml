<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="0035-create-mailbox-reactions" author="bioritmic">
        <createTable tableName="mailbox_reactions">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="mail_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="reaction" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="reacted_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="mailbox_reactions"
                baseColumnNames="mail_id"
                referencedTableName="mailbox"
                referencedColumnNames="id"
                constraintName="fk_mailbox_reactions_mail_id"
                onDelete="CASCADE"/>

        <addForeignKeyConstraint
                baseTableName="mailbox_reactions"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_mailbox_reactions_user_id"
                onDelete="CASCADE"/>

        <createIndex tableName="mailbox_reactions" indexName="idx_mailbox_reactions_mail_id">
            <column name="mail_id"/>
        </createIndex>

        <createIndex tableName="mailbox_reactions" indexName="idx_mailbox_reactions_user_id">
            <column name="user_id"/>
        </createIndex>

        <addUniqueConstraint
                tableName="mailbox_reactions"
                columnNames="mail_id,user_id"
                constraintName="uq_mailbox_reactions_mail_user"/>
    </changeSet>

</databaseChangeLog>
