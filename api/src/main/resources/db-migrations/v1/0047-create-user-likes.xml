<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="0047-create-user-likes" author="bioritmic">
        <createTable tableName="user_likes">
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="other_user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="timestamp" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="user_likes" columnNames="user_id, other_user_id" constraintName="pk_user_likes"/>

        <createIndex tableName="user_likes" indexName="idx_user_likes_user_id">
            <column name="user_id"/>
        </createIndex>

        <createIndex tableName="user_likes" indexName="idx_user_likes_other_user_id">
            <column name="other_user_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
