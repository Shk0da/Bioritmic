<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="0038-create-swipe-skips" author="cursor">
        <createTable tableName="swipe_skips">
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="other_user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="timestamp" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="swipe_skips" columnNames="user_id, other_user_id" constraintName="pk_swipe_skips"/>

        <createIndex tableName="swipe_skips" indexName="idx_swipe_skips_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
