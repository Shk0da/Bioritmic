<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="0007-create-interests" author="bioritmic">
        <createTable tableName="interests">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="icon" type="VARCHAR(50)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="interests" indexName="idx_interests_category">
            <column name="category"/>
        </createIndex>
        <createIndex tableName="interests" indexName="idx_interests_name_unique" unique="true">
            <column name="name"/>
        </createIndex>
    </changeSet>

    <changeSet id="0007-create-user-interests" author="bioritmic">
        <createTable tableName="user_interests">
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="interest_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="user_interests" columnNames="user_id, interest_id"/>
        <createIndex tableName="user_interests" indexName="idx_user_interests_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="user_interests" indexName="idx_user_interests_interest_id">
            <column name="interest_id"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="user_interests" baseColumnNames="interest_id"
                                 referencedTableName="interests" referencedColumnNames="id"
                                 constraintName="fk_user_interests_interest"/>
    </changeSet>

