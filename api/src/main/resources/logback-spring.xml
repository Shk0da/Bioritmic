<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{requestId:-}] [%X{userId:-}] [%X{method:-} %X{path:-}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/bioritmic.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/bioritmic.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{requestId:-}] [%X{userId:-}] [%X{method:-} %X{path:-}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Production: no SQL / R2DBC debug noise -->
    <springProfile name="production">
        <logger name="com.github.shk0da.bioritmic" level="INFO"/>
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.springframework.web" level="WARN"/>
        <logger name="org.springframework.security" level="WARN"/>
        <logger name="org.springframework.r2dbc" level="WARN"/>
        <logger name="io.r2dbc" level="WARN"/>
        <logger name="io.r2dbc.postgresql.QUERY" level="WARN"/>
        <logger name="io.r2dbc.postgresql.PARAM" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Local develop: verbose SQL tracing -->
    <springProfile name="develop">
        <logger name="com.github.shk0da.bioritmic" level="DEBUG"/>
        <logger name="com.github.shk0da.bioritmic.api" level="DEBUG"/>
        <logger name="io.r2dbc.postgresql.QUERY" level="DEBUG"/>
        <logger name="io.r2dbc.postgresql.PARAM" level="DEBUG"/>
        <logger name="org.springframework.r2dbc.core.DefaultDatabaseClient" level="DEBUG"/>
        <logger name="org.springframework.r2dbc.connection.R2dbcTransactionManager" level="DEBUG"/>
        <logger name="org.springframework" level="INFO"/>
        <logger name="org.springframework.web" level="INFO"/>
        <logger name="org.springframework.security" level="WARN"/>
        <logger name="io.r2dbc" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Docker dev / test / other non-production profiles -->
    <springProfile name="!production &amp; !develop">
        <logger name="com.github.shk0da.bioritmic" level="INFO"/>
        <logger name="org.springframework" level="INFO"/>
        <logger name="org.springframework.web" level="INFO"/>
        <logger name="org.springframework.security" level="WARN"/>
        <logger name="org.springframework.r2dbc" level="WARN"/>
        <logger name="io.r2dbc" level="WARN"/>
        <logger name="io.r2dbc.postgresql.QUERY" level="WARN"/>
        <logger name="io.r2dbc.postgresql.PARAM" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
