# Production .env for bioritmic.ru — copy to .env on the VPS:
#   cp .env.production.example .env

APP_FRONTEND_URL=https://bioritmic.ru
APP_BASE_URL=https://bioritmic.ru
APP_CORS_ALLOWED_ORIGINS=https://bioritmic.ru,https://158.160.194.159

SSL_DOMAIN=bioritmic.ru
SSL_PUBLIC_IP=158.160.194.159
CERTBOT_EMAIL=admin@bioritmic.ru

# Outbound mail: Yandex Cloud Postbox (recommended for production)
PROD_MAIL=0
MAIL_HOST=postbox.cloud.yandex.net
MAIL_PORT=587
MAIL_USERNAME=noreply@bioritmic.ru
MAIL_PASSWORD=your-postbox-smtp-password
MAIL_FROM=noreply@bioritmic.ru
MAIL_FROM_NAME=Bioritmic
MAIL_DOMAIN=bioritmic.ru
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_SSL_TRUST=postbox.cloud.yandex.net

# Host ports (production uses 80/443 via start-prod.sh)
UI_PORT=80
UI_HTTPS_PORT=443

# Self-hosted mail (docker-mailserver) — only if PROD_MAIL=1 and MAIL_HOST=mail
# PROD_MAIL=1
# MAIL_HOST=mail
# MAIL_PORT=587
