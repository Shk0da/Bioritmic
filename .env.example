# Copy to .env — host ports avoid conflicts with local services.
#
# Application
API_PORT=6045
API_ACTUATOR_PORT=6046
UI_PORT=2399
UI_HTTPS_PORT=2443
APP_FRONTEND_URL=http://localhost:2399
# Comma-separated extra browser origins for CORS (e.g. server IP before DNS is ready):
# APP_CORS_ALLOWED_ORIGINS=https://158.160.194.159,https://bioritmic.ru
# Production (./start-prod.sh): UI_PORT=80, UI_HTTPS_PORT=443
# Let's Encrypt (auto via certbot):
#   SSL_DOMAIN=bioritmic.ru
#   CERTBOT_EMAIL=admin@bioritmic.ru
#   APP_FRONTEND_URL=https://bioritmic.ru
#   CERTBOT_STAGING=true   # optional: test issuance without rate limits
# Manual TLS: place fullchain.pem + privkey.pem in docker/monolith/certs/
# SSL_CERT_DIR=./docker/monolith/certs
#
# First admin via email (for dev/screenshot tests). Register this user to get ADMIN + verified.
ADMIN_EMAIL=screenshot-admin@test.com
#
# E2E seed admin (develop profile, migration 9998-test-users.xml)
E2E_ADMIN_EMAIL=testuser1@example.com
E2E_ADMIN_PASSWORD=Test123456
#
# PostgreSQL in Docker (local install often uses 5432)
POSTGRES_PORT=5433
#
# MinIO in Docker (local install often uses 9000/9001)
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
#
# Mail server in Docker (local SMTP often uses 25/587/993)
MAIL_PORT=2587
MAIL_PLAIN_PORT=2525
MAIL_IMAP_PORT=2993
#
# Optional Mailpit profile: docker compose --profile mailpit up -d mailpit
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025
#
# Self-hosted mail (docker compose service "mail", hostname mail.bioritmic.ru)
MAIL_HOST=localhost
MAIL_USERNAME=noreply@bioritmic.ru
MAIL_PASSWORD=changeme
MAIL_FROM=noreply@bioritmic.ru
MAIL_FROM_NAME=Bioritmic
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=false
# Self-signed cert from docker-mailserver in dev
MAIL_SSL_TRUST=localhost,mail.bioritmic.ru
#
# Firebase Cloud Messaging (push notifications; optional in dev)
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_VAPID_KEY=
