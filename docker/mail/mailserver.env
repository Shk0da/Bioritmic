# Self-hosted mail server (docker-mailserver)
# https://docker-mailserver.github.io/docker-mailserver/latest/

OVERRIDE_HOSTNAME=mail.bioritmic.ru
POSTMASTER_ADDRESS=postmaster@bioritmic.ru
POSTFIX_MAILBOX_SIZE_LIMIT=0
ONE_DIR=1

ENABLE_CLAMAV=0
ENABLE_SPAMASSASSIN=0
ENABLE_RSPAMD=0
ENABLE_FAIL2BAN=0
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1

SSL_TYPE=self-signed
PERMIT_DOCKER=network

LOG_LEVEL=info
